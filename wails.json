{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "hashpad",
  "outputfilename": "Hashpad",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "Hashpad"
  },
  "info": {
    "companyName": "Hashpad",
    "productName": "Hashpad",
    "productVersion": "0.2.0",
    "copyright": "© 2026 Hashpad",
    "comments": "A lightweight markdown editor for Windows.",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Hashpad.Markdown",
        "description": "Markdown Document",
        "iconName": "mdicon",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Hashpad.Markdown",
        "description": "Markdown Document",
        "iconName": "mdicon",
        "role": "Editor"
      },
      {
        "ext": "mdown",
        "name": "Hashpad.Markdown",
        "description": "Markdown Document",
        "iconName": "mdicon",
        "role": "Editor"
      },
      {
        "ext": "mkd",
        "name": "Hashpad.Markdown",
        "description": "Markdown Document",
        "iconName": "mdicon",
        "role": "Editor"
      }
    ]
  }
}
