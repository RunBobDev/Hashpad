build/bin
node_modules
frontend/dist

# Wails rewrites this hash on every build, so tracking it makes the working
# tree dirty after any `wails build` and adds churn to unrelated commits.
frontend/package.json.md5

# Working notes, task briefs and scratch files,
# and the progress ledger.
.superpowers/

# Generated by `graphify update .` from the source tree, ~1 MB and rewritten on
# every code change. The tooling that consumes it is configured locally;
# the artifact itself is not.
graphify-out/
.local/tooling-settings.bak

# Local tooling configuration. Kept on disk, out of the repository:
# it is machine-specific (absolute paths), and it is not part of Hashpad.
.tooling/
TOOLING.md

# Working notes from the build process — handover documents and per-phase
# implementation plans. The decisions they produced live in docs/design.md,
# which is the record worth keeping.
docs/HANDOFF.md
docs/superpowers/
build/README.md
